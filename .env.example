SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Local development only. Production must use the hosted connection string
# supplied by the database provider (for example, Neon or Supabase).
DATABASE_URL=postgresql://portfolio_user:password@localhost:5432/portfolio_db

# Required for the live GitHub contribution graph (read:user scope is enough).
GITHUB_TOKEN=

# Required for the currently/last-listened Spotify strip.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Email Push Notification
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Single-User & Stealth Admin Configuration
ADMIN_USERNAME=
ADMIN_GATE_KEY=

# Production: DEBUG=False, explicit ALLOWED_HOSTS, and a strong SECRET_KEY.
# Set only when your proxy strips incoming X-Forwarded-Proto and sets it itself.
TRUST_PROXY_HTTPS=0

# Optional shared cache for multiple workers; run migrations before enabling.
USE_DATABASE_CACHE=0

# Durable uploaded files: use an S3-compatible bucket, required on Vercel.
# Keep these empty for local filesystem storage.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Alternative for a persistent server: mount a durable directory and serve it
# at MEDIA_URL through your web server. This does not work on ephemeral hosts.
MEDIA_ROOT=
MEDIA_URL=/media/
